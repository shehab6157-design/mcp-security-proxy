# Copy this file to .env (gitignored) and fill in real values.
# Get a bot token from @BotFather on Telegram, and your numeric chat_id by
# messaging the bot once and checking https://api.telegram.org/bot<token>/getUpdates
#
# trigger/run.py works without these set - notifications just print to
# stdout instead of reaching Telegram.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
